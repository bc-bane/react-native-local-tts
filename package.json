{
  "name": "react-native-local-tts",
  "version": "0.1.4",
  "description": "Expo module for local text-to-speech synthesis on iOS and Android. Speak text aloud, synthesize to audio files, list available voices, and receive word-level progress events.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "android/src",
    "android/build.gradle",
    "ios",
    "expo-module.config.json",
    "react-native-local-tts.podspec"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "rm -rf dist && tsc"
  },
  "keywords": [
    "expo-module",
    "expo",
    "tts",
    "text-to-speech",
    "speech",
    "synthesis",
    "voice",
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bc-bane/react-native-local-tts"
  },
  "author": "bc-bane",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bc-bane/react-native-local-tts/issues"
  },
  "homepage": "https://github.com/bc-bane/react-native-local-tts#readme",
  "engines": {
    "node": ">=20.19.4"
  },
  "expo": {
    "autoInstall": true,
    "name": "LocalTtsModule"
  },
  "peerDependencies": {
    "expo": ">=56.0.0",
    "react": ">=19.2.0",
    "react-native": ">=0.78.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "expo": "^56.0.0",
    "expo-modules-core": "~56.0.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "typescript": "^5.0.0"
  }
}
